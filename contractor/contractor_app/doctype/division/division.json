{
 "doctype": "DocType",
 "name": "Division",
 "module": "Contractor App",
 "engine": "InnoDB",
 "autoname": "field:title",
 "naming_rule": "By fieldname",
 "title_field": "title",
 "search_fields": "title,description",
 "allow_rename": 1,
 "allow_import": 1,
 "field_order": [
  "title",
  "description"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "share": 1
  }
 ],
 "sort_field": "name",
 "sort_order": "ASC"
}
