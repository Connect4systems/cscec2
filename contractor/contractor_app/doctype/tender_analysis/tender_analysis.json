{
 "doctype": "DocType",
 "name": "Tender Analysis",
 "module": "Contractor App",
 "engine": "InnoDB",
 "field_order": [
  "title",
  "tender_number",
  "company",
  "date",
  "party_type",
  "party_name",
  "currency",
  "numbering_mode",
  "clauses",
  "total_amount"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1
  },
  {
   "fieldname": "tender_number",
   "fieldtype": "Data",
   "label": "Tender Number",
   "reqd": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "default": "Today",
   "reqd": 1
  },
  {
   "fieldname": "party_type",
   "fieldtype": "Select",
   "label": "Party Type",
   "options": "Customer\nLead\nProspect",
   "reqd": 1
  },
  {
   "fieldname": "party_name",
   "fieldtype": "Dynamic Link",
   "label": "Party Name",
   "options": "party_type",
   "reqd": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "numbering_mode",
   "fieldtype": "Select",
   "label": "Numbering Mode",
   "options": "Automatic\nFrom Excel",
   "default": "Automatic",
   "reqd": 1
  },
  {
   "fieldname": "clauses",
   "fieldtype": "Table",
   "label": "Clauses",
   "options": "Tender Analysis Clause"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "options": "currency",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1
  }
 ],
 "istable": 0,
 "editable_grid": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "format:TA-{YYYY}-{#####}",
 "title_field": "title",
 "track_changes": 1
}
